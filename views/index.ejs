<!DOCTYPE html>
<html lang="en">
<%- include('partials/head.ejs') %>
<body>


 <h1> Quote Finder </h1>
   <form action="/searchByKeyword">
     Keyword: 
     <input type="text" name="keyword">
     <button>Search by Keyword</button>
   </form>

   <form action="/searchByAuthor">
     <select name="authorId">
       <% for (author of authors) { %>
         <option value="<%=author.authorId%>">
            <%=author.firstName%>  <%=author.lastName%>
         </option>
        <%  }  %>
     </select>
     <button>Search by Author</button>
    </form>

    <form action="/searchByCategory">
      <select name="category">
        <% for (quoteCat of quoteCats) { %>
        <option value="<%=quoteCat.category%>">
          <%=quoteCat.category%>
        </option>
        <%  }  %>        
      </select>
      <button>Search by Quote Category</button>
    </form>

    <form action="/searchByLikes">
     Minimum Likes: 
     <input type="number" name="minLikes">
     Maximum Likes:
     <input type="number" name="maxLikes">
     <button>Search by Amount of Likes</button>
    </form>

<%- include('partials/footer.ejs') %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="js/scripts.js"></script>
</body>

</html>